# Browser-safe Supabase configuration. Prefer the publishable key; the anon key
# remains available only for deployments that have not rotated yet.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Server-only Edge Function configuration. Never expose these names through VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEYS=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SECRET_KEYS=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_ID_DERIVATION_SECRET=
LOGIN_RATE_LIMIT_SECRET=
CORS_ALLOWED_ORIGINS=
SW000_BOOTSTRAP_PASSWORD=
ATTENDANCE_CLEANUP_SECRET=
